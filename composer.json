{
    "name": "naufkia/kyaaaa-php",
    "description": "Kyaaaa Weird PHP Framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "naufkia"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/"
        },
        "files": [
            "core/Conf/Kyaaaa/Common.php"
        ]
    },
    "scripts": {
        "serve": "@php kyaaaa",
        "test": "@php tests/smoke.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
