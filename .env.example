# Copy to .env (never commit .env).
# development = detailed error pages, anything else = production
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# Public URL, strongly recommended in production
APP_URL=
# Comma separated list of accepted Host headers (empty = any)
APP_ALLOWED_HOSTS=
# Extra hosts redirectTo() may redirect to (comma separated)
APP_REDIRECT_HOSTS=
# true only behind a trusted reverse proxy / CDN that sets X-Forwarded-Proto
TRUST_PROXY=false

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kyaaaa_db
DB_USERNAME=root
DB_PASSWORD=
DB_SQLITE_PATH=
DB_SSL_CA=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_CRYPTO=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
